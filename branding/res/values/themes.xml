<?xml version="1.0" encoding="utf-8"?>
<!-- GlobaleSIM look for the card manager: same colors as globalesim.tel
     (night navy header, paper background, amber accent). Overrides the upstream theme. -->
<resources>
    <color name="gs_night">#0E1A2B</color>
    <color name="gs_night2">#17283F</color>
    <color name="gs_amber">#FFB547</color>
    <color name="gs_amber2">#FFCF85</color>
    <color name="gs_paper">#F4F6F9</color>
    <color name="gs_card">#FFFFFF</color>
    <color name="gs_ink">#13202F</color>
    <color name="gs_muted">#5E6B7A</color>
    <color name="gs_line">#D9E0E8</color>
    <color name="gs_go">#178F78</color>

    <style name="Theme.OpenEUICC" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/gs_night</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/gs_amber</item>
        <item name="colorOnPrimaryContainer">@color/gs_night</item>
        <item name="colorSecondary">@color/gs_go</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FFF1DC</item>
        <item name="colorOnSecondaryContainer">@color/gs_night</item>
        <item name="colorTertiary">@color/gs_go</item>
        <item name="colorAccent">@color/gs_go</item>
        <item name="android:colorBackground">@color/gs_paper</item>
        <item name="colorSurface">@color/gs_paper</item>
        <item name="colorOnSurface">@color/gs_ink</item>
        <item name="colorSurfaceVariant">@color/gs_night</item>
        <item name="colorOnSurfaceVariant">@color/gs_muted</item>
        <item name="colorSurfaceContainerLowest">@color/gs_card</item>
        <item name="colorSurfaceContainerLow">@color/gs_card</item>
        <item name="colorSurfaceContainer">#EAEEF3</item>
        <item name="colorSurfaceContainerHigh">#E4E9EF</item>
        <item name="colorSurfaceContainerHighest">#DDE3EA</item>
        <item name="colorOutline">#B8C3CF</item>
        <item name="colorOutlineVariant">@color/gs_line</item>
        <item name="materialCardViewStyle">@style/GsCard</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/gs_night</item>
        <item name="android:navigationBarColor">@color/gs_paper</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="toolbarStyle">@style/ToolbarTheme</item>
        <item name="dialogCornerRadius">16dp</item>
    </style>

    <style name="GsCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/gs_card</item>
        <item name="strokeColor">@color/gs_line</item>
        <item name="cardCornerRadius">14dp</item>
    </style>

    <style name="ToolbarTheme" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/gs_night</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="subtitleTextColor">#C9D3DF</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <style name="AlertDialogTheme" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="colorPrimary">@color/gs_night</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="dialogCornerRadius">16dp</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/gs_muted</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/gs_go</item>
    </style>
</resources>
